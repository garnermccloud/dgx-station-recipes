+# and encodes them without the added vocabulary, exactly as the recipe's PromptTokenizer does.
+_ESC = "\ue000"
+_UNESCAPE = re.compile("\ue000(\ue000?)")
+_GROUNDING_TOKENS = ("<｜ref｜>", "<｜/ref｜>", "<｜box｜>", "<｜/box｜>",
