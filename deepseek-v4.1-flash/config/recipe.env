# Fixed recipe constants.  One source of truth for the fastpath component list, the MegaMoE
# rowmap, the pinned FlashInfer tune file and the default GB300 utilisation.  The first three are
# not operator knobs: the release ships exactly one recipe.  Override only by editing this file
# (and re-running verify).  The component order matters: quant_producer, a12_retire and
# a12_memory_guard wrap the graph capture in that order, with the guard last.
DS41_FASTPATH_COMPONENTS='tail_markov_fused,tail_swa_meta,tail_dflash_prep,tail_ctxkv,tail_replay_skip,tail_embed,tail_drafthead_mxfp8,attn,preattn,preattn_cand,preattn_index,preattn_compress,tail_draft_embed,boundary,suffix,ds41_sampling,ds41_stop,topp_fast,w8oproj,tail_proj_side,lowb_aux,engram_side,fastload,coldskip,peer3,megamoe,quant_producer,a12_retire,a12_memory_guard'
DS41_ROWMAP='rowmap-mix-v1-h255.json'
DS41_FI_TUNE_FILE='fiset-w6pf-post1-c7483c4a.json'
# Default --gpu-memory-utilization for a GB300 that runs only ds41.  DS41_UTIL in ~/.ds41/config.env
# (or the environment) overrides it, e.g. lower when another process shares the GB300.
DS41_UTIL_DEFAULT='0.95'
