# ds41 configuration (optional).  Every value below is a default; environment variables win.
# `ds41 install` writes this file to ~/.ds41/config.env; edit it there, or point DS41_CONFIG at a copy.
: "${DS41_HOME:=$HOME/.ds41}"

# --- paths -----------------------------------------------------------------
# Official 1017 checkpoint (MIT).  `ds41 install` downloads it here unless you point this at an
# existing complete checkpoint; install verifies config.json, model.safetensors.index.json and all
# 48 shards, then skips the download.
: "${DS41_MODEL_DIR:=$DS41_HOME/models/DeepSeek-V4.1-Flash-1017}"
# Official Hugging Face revision used by `ds41 install`.
: "${DS41_MODEL_REV:=1bae0e1088993b9b82de08f59de5be5a34e42170}"
# Caches: vLLM compile cache, FlashInfer, Triton, sidecar b12x cache, profiler dumps.
: "${DS41_CACHE_DIR:=$DS41_HOME/state}"
# Runtime trees mounted read-only from this checkout.  The stock image is not modified.
: "${DS41_FASTPATH_DIR:=$HOME/ds41/fastpath}"
: "${DS41_HOOK_DIR:=$DS41_FASTPATH_DIR/hook}"
: "${DS41_B12X_DIR:=$HOME/ds41/docker/b12x}"
: "${DS41_OVERLAY_1017_DIR:=$HOME/ds41/docker/overlay-1017/vllm}"
: "${DS41_OVERLAY_58132_DIR:=$HOME/ds41/docker/overlay-58132/vllm}"
: "${DS41_SITECUSTOMIZE:=$HOME/ds41/fastpath/sitecustomize.py}"

# --- endpoint --------------------------------------------------------------
: "${DS41_PORT:=30003}"
: "${DS41_API_KEY_FILE:=$DS41_HOME/api-key}"
: "${DS41_SERVED:=deepseek-v4.1-flash}"
: "${DS41_ALIASES:=deepseek DeepSeek-V4.1-Flash dsv41}"
: "${DS41_EFFORT:=high}"

# --- GPUs ------------------------------------------------------------------
# Both GPUs are required; a missing RTX PRO 6000 is a preflight failure, not a fallback.
# auto: find the GB300 and the RTX PRO 6000 by PCI name.  Set a UUID to pin one.
: "${DS41_GPU_GB300:=auto}"
: "${DS41_GPU_RTX:=auto}"
# cdi: Docker CDI (--device nvidia.com/gpu=UUID); runtime: NVIDIA runtime (--gpus device=UUID).
: "${DS41_GPU_MODE:=cdi}"

# --- model / engine --------------------------------------------------------
# Fraction of the GB300 the server may use.  The default is DS41_UTIL_DEFAULT in config/recipe.env
# (chosen for a GB300 that runs only ds41).  Lower it if another process shares the GB300.
# : "${DS41_UTIL:=...}"
# Memory (MiB) another process on the GB300 may still allocate after ds41 is up.  The startup guard
# (a12_memory_guard) refuses to serve unless this much stays free after CUDA-graph capture, on top of
# the measured runtime peak.  0 on a dedicated GB300.
: "${DS41_GPU_RESERVE_MIB:=0}"
: "${DS41_MAXLEN:=524288}"
: "${DS41_KV:=nvfp4_ds_mla}"
: "${DS41_SEQS:=32}"
: "${DS41_OFFLOAD_GB:=120}"
: "${DS41_OFFLOAD_THRESHOLD:=2}"

# --- recipe ----------------------------------------------------------------
# The fastpath component list, MegaMoE rowmap and pinned FlashInfer tune file are fixed release
# constants in config/recipe.env.  They are not user knobs and are not repeated here.
# The recipe always enables DSpark speculative decoding with the published schedule, fastload,
# coldskip, peer3, MegaMoE, quant_producer and a12_retire/a12_memory_guard; there is no no-spec / A/B arm.

# --- containers ------------------------------------------------------------
# The supported image is fixed by the compatibility check (serve/compat.sh); `ds41 install`
# pulls it.  The recipe's overlays, fastpath, hook and b12x are mounted read-only from this
# checkout at launch.  There is no image build.
: "${DS41_LOG_LEVEL:=INFO}"

# --- verify / bench ---------------------------------------------------------
# verify passes at >= this percentage of the published speed (default 80).
: "${DS41_MIN_PCT:=80}"
# GSM8K-200 must be at least this percentage (default 95).
: "${DS41_MIN_ACC:=95}"
